local player = game.Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.ResetOnSpawn = false
gui.Parent = player.PlayerGui

local dragButton = Instance.new("Frame")
dragButton.Size = UDim2.new(0, 60, 0, 60)
dragButton.Position = UDim2.new(0.02, 0, 0.1, 0)
dragButton.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
dragButton.BorderSizePixel = 0
dragButton.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = dragButton

local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, 0, 1, 0)
label.BackgroundTransparency = 1
label.Text = "⚡"
label.TextColor3 = Color3.fromRGB(255, 255, 255)
label.Font = Enum.Font.Bold
label.TextSize = 30
label.Parent = dragButton

-- ========== ПЕРЕТАСКИВАНИЕ (FIX) ==========
local dragging = false
local dragStartPos = nil
local dragStartMouse = nil

dragButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStartPos = dragButton.Position
        dragStartMouse = input.Position
    end
end)

dragButton.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStartMouse
        dragButton.Position = UDim2.new(
            dragStartPos.X.Scale,
            dragStartPos.X.Offset + delta.X,
            dragStartPos.Y.Scale,
            dragStartPos.Y.Offset + delta.Y
        )
    end
end)

dragButton.MouseButton1Click:Connect(function()
    print("Квадрат нажат!")
end)
