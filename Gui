-- SUPER PANEL v3.0 (FINAL)
local player = game.Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player.PlayerGui

-- ========== ЗАСТАВКА ==========
local splash = Instance.new("Frame")
splash.Size = UDim2.new(1, 0, 1, 0)
splash.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
splash.BorderSizePixel = 0
splash.ZIndex = 5
splash.Parent = gui

local splashTitle = Instance.new("TextLabel")
splashTitle.Size = UDim2.new(1, 0, 0, 80)
splashTitle.Position = UDim2.new(0, 0, 0.35, 0)
splashTitle.BackgroundTransparency = 1
splashTitle.Text = "🔥 SUPER PANEL 🔥"
splashTitle.TextColor3 = Color3.fromRGB(0, 255, 255)
splashTitle.Font = Enum.Font.Bold
splashTitle.TextSize = 50
splashTitle.TextStrokeColor3 = Color3.fromRGB(0, 150, 200)
splashTitle.TextStrokeTransparency = 0.3
splashTitle.Parent = splash

local subText = Instance.new("TextLabel")
subText.Size = UDim2.new(1, 0, 0, 40)
subText.Position = UDim2.new(0, 0, 0.5, 0)
subText.BackgroundTransparency = 1
subText.Text = "Загрузка..."
subText.TextColor3 = Color3.fromRGB(150, 150, 200)
subText.Font = Enum.Font.SourceSans
subText.TextSize = 20
subText.Parent = splash

-- Пульсация заголовка
local pulse = splashTitle:Clone()
pulse.Parent = splash
pulse.Text = "🔥 SUPER PANEL 🔥"
pulse.TextColor3 = Color3.fromRGB(255, 255, 255)
pulse.TextTransparency = 0.8
pulse.TextSize = 52
pulse.BackgroundTransparency = 1

spawn(function()
    while splash.Parent do
        pulse.TextTransparency = 0.8
        task.wait(0.5)
        pulse.TextTransparency = 0.3
        task.wait(0.5)
    end
end)

-- Анимация появления заставки
splash.BackgroundTransparency = 0
for i = 1, 10 do
    splashTitle.TextSize = 40 + i
    task.wait(0.03)
end

task.wait(2)

-- Плавное исчезновение заставки
for i = 1, 10 do
    splash.BackgroundTransparency = i / 10
    splashTitle.TextTransparency = i / 10
    subText.TextTransparency = i / 10
    task.wait(0.05)
end
splash:Destroy()

